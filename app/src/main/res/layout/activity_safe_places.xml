

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nearby Safe Places"
            android:textColor="#252525"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Find nearby places that may help during an emergency."
            android:textColor="#666666"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnPolice"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="30dp"
            android:text="🚔  Find Police Stations"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnHospital"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="18dp"
            android:text="🏥  Find Hospitals"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnPharmacy"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="18dp"
            android:text="💊  Find Pharmacies"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Note: Google Maps will show search results. Check the location, availability and contact details before travelling."
            android:textColor="#777777"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
